#!/usr/bin/env bash
# arch-maintenance: the interactive half of Arch Linux upkeep.
#
# Run as your normal user; sudo is requested only for steps that need it.
# The unattended half (Flatpak updates, package cache trimming, mirror refresh,
# TRIM, pacman DB snapshots, daily status notification) runs from systemd
# timers and a pacman hook installed by install.sh.

set -euo pipefail

readonly VERSION=2.1.0

# Tunables (environment overrides)
MAX_AGE_DAYS=${ARCH_MAINT_MAX_AGE_DAYS:-14}   # nag when the last full upgrade is older than this
DISK_WARN_PCT=${ARCH_MAINT_DISK_WARN_PCT:-90} # warn when a filesystem is fuller than this
CACHE_KEEP=${ARCH_MAINT_CACHE_KEEP:-2}        # package versions `clean` keeps in the pacman cache
AUR_CHECK=${ARCH_MAINT_AUR_CHECK:-1}          # 0 turns off the AUR drift check
AUR_FIXTURE=${ARCH_MAINT_AUR_FIXTURE:-}       # test only: directory standing in for pacman, the AUR and arch-audit

readonly AUR_RPC=https://aur.archlinux.org/rpc/v5/info
readonly AUR_CGIT=https://aur.archlinux.org/cgit/aur.git/plain/PKGBUILD
readonly AUR_TTL=21600 # seconds an AUR RPC response is reused
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/arch-maintenance
CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/arch-maintenance
BASELINE=$STATE_DIR/aur-baseline.tsv

if [[ -t 1 ]]; then
  BOLD=$'\e[1m' RED=$'\e[31m' GREEN=$'\e[32m' YELLOW=$'\e[33m' BLUE=$'\e[34m' NC=$'\e[0m'
else
  BOLD='' RED='' GREEN='' YELLOW='' BLUE='' NC=''
fi

section() { printf '\n%s==> %s%s\n' "$BLUE$BOLD" "$1" "$NC"; }
ok() { printf '  %s✓%s %s\n' "$GREEN" "$NC" "$1"; }
note() { printf '  %s•%s %s\n' "$BLUE" "$NC" "$1"; }
warn() { printf '  %s!%s %s\n' "$YELLOW" "$NC" "$1"; }
die() { printf '%serror:%s %s\n' "$RED" "$NC" "$1" >&2; exit 1; }
have() { command -v "$1" &>/dev/null; }

# confirm "question" [y|n]  (second argument is the default answer)
confirm() {
  local default=${2:-n} prompt reply
  [[ $default == y ]] && prompt='[Y/n]' || prompt='[y/N]'
  read -rp "  $1 $prompt " reply || return 1
  reply=${reply:-$default}
  [[ ${reply,,} == y* ]]
}

usage() {
  cat <<EOF
Usage: arch-maintenance [command]

Commands:
  status [--notify]  Report system health (default). --notify sends a desktop
                     notification when something needs attention.
  update             Arch news, AUR drift check, full upgrade (repo + AUR),
                     baseline refresh, Flatpak update, .pacnew merge, reboot check.
  clean              Review orphans, trim pacman and AUR caches.
  aur check          Report AUR changes since the baseline; exit 1 on drift.
  aur baseline [--yes]
                     Record the installed AUR packages' maintainers and
                     PKGBUILD hashes; status reports changes against it.
  help               Show this help.
  version            Show version.

Environment:
  ARCH_MAINT_MAX_AGE_DAYS   Days before a stale upgrade is flagged (default 14)
  ARCH_MAINT_DISK_WARN_PCT  Disk usage warning threshold (default 90)
  ARCH_MAINT_CACHE_KEEP     Cached versions kept by 'clean' (default 2)
  ARCH_MAINT_AUR_CHECK      Set to 0 to turn off the AUR drift check (default 1)
  DIFFPROG                  Merge tool passed to pacdiff (default: vim -d)
EOF
}

# ---------------------------------------------------------------------------
# Checks
# ---------------------------------------------------------------------------

last_upgrade_days() {
  local ts
  ts=$(grep -a 'starting full system upgrade' /var/log/pacman.log 2>/dev/null | tail -n1 | sed -E 's/^\[([^]]+)\].*/\1/')
  [[ -n $ts ]] || { echo -1; return; }
  echo $(( ($(date +%s) - $(date -d "$ts" +%s)) / 86400 ))
}

# The running kernel's modules disappear once a newer kernel is installed.
# Containers have no kernels in /usr/lib/modules, so there is nothing to compare.
reboot_needed() {
  compgen -G '/usr/lib/modules/*/vmlinuz' >/dev/null && [[ ! -d /usr/lib/modules/$(uname -r) ]]
}

pacnew_files() { pacdiff -o 2>/dev/null || true; }

failed_units() {
  systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}'
  systemctl --user --failed --no-legend --plain 2>/dev/null | awk '{print $1 " (user)"}'
}

# Real filesystems above the warning threshold, as "NN% /mount".
full_filesystems() {
  df --output=pcent,target -x tmpfs -x devtmpfs -x efivarfs -x overlay -x squashfs 2>/dev/null |
    awk -v max="$DISK_WARN_PCT" 'NR > 1 { p = $1; sub(/%/, "", p); if (p + 0 > max) print $1 " " $2 }'
}

# makepkg's `debug` option builds a *-debug package for every AUR build.
makepkg_debug_enabled() {
  local conf="${XDG_CONFIG_HOME:-$HOME/.config}/pacman/makepkg.conf"
  # grep exits 2 for the optional files that don't exist; don't let pipefail see it
  { grep -hsE '^[[:space:]]*OPTIONS=' /etc/makepkg.conf /etc/makepkg.conf.d/*.conf "$conf" "$HOME/.makepkg.conf" || true; } |
    tail -n1 | grep -qE '[( ]debug[ )]'
}

dir_size() { du -sh "$1" 2>/dev/null | cut -f1; }

# ---------------------------------------------------------------------------
# AUR drift
#
# The baseline records, per installed AUR package base, the maintainer, the
# AUR's last-modified time and a hash of the PKGBUILD. Later checks compare the
# AUR's current state against it. The maintainer is "-" for an orphan and "~"
# for a package that is not on the AUR (built locally).
# ---------------------------------------------------------------------------

declare -A INST_VER AUR_VER AUR_MAINT AUR_MOD AUR_OOD BL_VER BL_MAINT BL_MOD BL_HASH
AUR_BASES=()
AUR_ERR=''

# Installed foreign packages as "pkgbase<TAB>pkgname<TAB>version". Split
# packages (e.g. *-debug) share their base's name in the local database.
aur_installed() {
  if [[ -n $AUR_FIXTURE ]]; then cat "$AUR_FIXTURE/installed.tsv"; return; fi
  local db name ver base
  db=$(pacman-conf DBPath 2>/dev/null || echo /var/lib/pacman/)
  pacman -Qm 2>/dev/null | while read -r name ver; do
    base=$(awk '/^%BASE%$/ { getline; print; exit }' "${db}local/$name-$ver/desc" 2>/dev/null) || true
    printf '%s\t%s\t%s\n' "${base:-$name}" "$name" "$ver"
  done
}

# AUR RPC info for the given package names, as {"results": [...]}. Reuses a
# cached response for AUR_TTL seconds unless asked to refresh.
aur_info() {
  local refresh=$1 key cache=$CACHE_DIR/aur-info.json stamp=$CACHE_DIR/aur-info.key
  shift
  if [[ -n $AUR_FIXTURE ]]; then cat "$AUR_FIXTURE/rpc.json"; return; fi
  have curl && have jq || return 2
  key=$(printf '%s\n' "$@" | sort | sha256sum | cut -d' ' -f1)
  if [[ -z $refresh && -f $cache && -f $stamp && $(<"$stamp") == "$key" ]] &&
    (( $(date +%s) - $(stat -c %Y "$cache") < AUR_TTL )); then
    cat "$cache"; return
  fi
  local chunk out='' args=() i n
  for (( i = 0; i < $#; i += 100 )); do
    args=()
    for n in "${@:i+1:100}"; do args+=(--data-urlencode "arg[]=$n"); done
    chunk=$(curl -fsS -m 20 -G "${args[@]}" "$AUR_RPC") || return 1
    jq -e '.type != "error"' <<<"$chunk" >/dev/null || return 1
    out+=$chunk$'\n'
  done
  out=$(jq -s '{results: [.[].results[]]}' <<<"$out") || return 1
  mkdir -p "$CACHE_DIR"
  printf '%s\n' "$out" >"$cache"
  printf '%s\n' "$key" >"$stamp"
  printf '%s\n' "$out"
}

aur_pkgbuild_hash() {
  if [[ -n $AUR_FIXTURE ]]; then
    sha256sum "$AUR_FIXTURE/PKGBUILD/$1" 2>/dev/null | cut -d' ' -f1 | grep .
    return
  fi
  curl -fsS -m 20 "$AUR_CGIT?h=$1" | sha256sum | cut -d' ' -f1
}

# Fill INST_* and AUR_* from the installed packages and the AUR. Returns 1
# with AUR_ERR set when the AUR cannot be queried.
aur_load() {
  local refresh=${1:-} base name ver maint mod ood info rc=0 names=()
  INST_VER=() AUR_VER=() AUR_MAINT=() AUR_MOD=() AUR_OOD=() AUR_BASES=() AUR_ERR=''
  while IFS=$'\t' read -r base name ver; do
    [[ -n ${INST_VER[$base]:-} ]] || { AUR_BASES+=("$base"); INST_VER[$base]=$ver; }
    names+=("$name" "$base")
  done < <(aur_installed)
  (( ${#AUR_BASES[@]} )) || return 0
  # Query bases too: an installed *-debug package may be the only foreign one.
  mapfile -t names < <(printf '%s\n' "${names[@]}" | sort -u)
  info=$(aur_info "$refresh" "${names[@]}") || rc=$?
  case $rc in
    0) ;;
    2) AUR_ERR="needs curl and jq"; return 1 ;;
    *) AUR_ERR="could not query the AUR"; return 1 ;;
  esac
  while IFS=$'\t' read -r base ver maint mod ood; do
    [[ -z ${AUR_VER[$base]:-} ]] || continue
    AUR_VER[$base]=$ver AUR_MAINT[$base]=$maint AUR_MOD[$base]=$mod AUR_OOD[$base]=$ood
  done < <(jq -r '.results[] | [.PackageBase, .Version, (.Maintainer // "-"), .LastModified, (.OutOfDate // "-")] | @tsv' <<<"$info")
}

aur_load_baseline() {
  local base ver maint mod hash
  BL_VER=() BL_MAINT=() BL_MOD=() BL_HASH=()
  [[ -f $BASELINE ]] || return 1
  while IFS=$'\t' read -r base ver maint mod hash; do
    [[ -z $base || $base == '#'* ]] && continue
    BL_VER[$base]=$ver BL_MAINT[$base]=$maint BL_MOD[$base]=$mod BL_HASH[$base]=${hash:--}
  done <"$BASELINE"
}

# Compare the loaded AUR state with the baseline. Prints
# "severity<TAB>package<TAB>message" lines; severity is crit, warn or info.
aur_drift() {
  local base cur old new
  for base in "${AUR_BASES[@]}"; do
    cur=${AUR_MAINT[$base]:-}
    if [[ -n ${BL_MAINT[$base]:-} ]]; then
      old=${BL_MAINT[$base]}
      if [[ -z $cur ]]; then
        [[ $old == '~' ]] || printf 'warn\t%s\tno longer on the AUR (was maintained by %s)\n' "$base" "$old"
        continue
      fi
      if [[ $old == '~' ]]; then
        printf 'crit\t%s\tnow on the AUR (maintainer %s) but was not at baseline\n' "$base" "$cur"
        continue
      fi
      if [[ $cur != "$old" ]]; then
        if [[ $cur == - ]]; then
          printf 'warn\t%s\torphaned (was maintained by %s)\n' "$base" "$old"
        elif [[ $old == - ]]; then
          printf 'crit\t%s\tadopted by %s (was orphaned)\n' "$base" "$cur"
        else
          printf 'crit\t%s\tmaintainer changed from %s to %s\n' "$base" "$old" "$cur"
        fi
      fi
      # The same version on both sides, yet the AUR changed since the baseline:
      # the PKGBUILD may differ without a release to show for it.
      if [[ ${BL_HASH[$base]} != - && ${AUR_VER[$base]} == "${INST_VER[$base]}" &&
        ${BL_VER[$base]} == "${INST_VER[$base]}" && ${AUR_MOD[$base]} != "${BL_MOD[$base]}" ]]; then
        if new=$(aur_pkgbuild_hash "$base"); then
          [[ $new == "${BL_HASH[$base]}" ]] ||
            printf 'warn\t%s\tPKGBUILD changed without a version change\n' "$base"
        else
          printf 'info\t%s\tcould not fetch the PKGBUILD to compare\n' "$base"
        fi
      fi
    elif [[ -n $cur && $cur == - ]]; then
      printf 'warn\t%s\torphaned\n' "$base"
    fi
    [[ -z ${AUR_OOD[$base]:-} || ${AUR_OOD[$base]} == - ]] ||
      printf 'info\t%s\tflagged out of date on the AUR\n' "$base"
  done
}

# Write the loaded state as the new baseline. Hashes are reused when nothing
# changed, fetched when the installed version matches the AUR's, and unknown
# ("-") when an update is pending, since only the latest PKGBUILD is served.
aur_baseline_write() {
  local base hash tmp
  mkdir -p "$STATE_DIR"
  tmp=$(mktemp "$STATE_DIR/.baseline.XXXXXX")
  printf '# arch-maintenance AUR baseline: base, version, maintainer, last_modified, pkgbuild_sha256\n' >"$tmp"
  for base in "${AUR_BASES[@]}"; do
    if [[ -z ${AUR_VER[$base]:-} ]]; then
      printf '%s\t%s\t~\t0\t-\n' "$base" "${INST_VER[$base]}" >>"$tmp"
      continue
    fi
    hash=-
    if [[ ${AUR_VER[$base]} == "${INST_VER[$base]}" ]]; then
      if [[ ${BL_VER[$base]:-} == "${INST_VER[$base]}" && ${BL_MOD[$base]:-} == "${AUR_MOD[$base]}" &&
        ${BL_HASH[$base]:--} != - ]]; then
        hash=${BL_HASH[$base]}
      else
        hash=$(aur_pkgbuild_hash "$base") || hash=-
      fi
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$base" "${INST_VER[$base]}" "${AUR_MAINT[$base]}" "${AUR_MOD[$base]}" "$hash" >>"$tmp"
  done
  mv "$tmp" "$BASELINE"
}


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

# Print the AUR section and append findings to the caller's `attention` array.
# Sets AUR_DRIFT to the number of warnings and critical findings.
AUR_DRIFT=0
aur_section() {
  local lines=() line sev pkg msg infos=0 has_baseline=true
  AUR_DRIFT=0
  [[ $AUR_CHECK != 0 ]] || return 0
  if ! aur_load; then
    section "AUR packages"
    warn "Drift check skipped: $AUR_ERR"
    return 0
  fi
  (( ${#AUR_BASES[@]} )) || return 0
  section "AUR packages"
  aur_load_baseline || has_baseline=false
  mapfile -t lines < <(aur_drift)
  for line in "${lines[@]}"; do
    IFS=$'\t' read -r sev pkg msg <<<"$line"
    if [[ $sev == info ]]; then
      note "$pkg: $msg"; infos=$((infos + 1))
    else
      warn "$pkg: $msg"
      attention+=("AUR $pkg: $msg")
      AUR_DRIFT=$((AUR_DRIFT + 1))
    fi
  done
  if ! $has_baseline; then
    note "No baseline yet; record one with: arch-maintenance aur baseline"
  elif (( AUR_DRIFT == 0 )); then
    ok "${#AUR_BASES[@]} AUR packages match the baseline"
  fi
}

# Installed packages with a known vulnerability that an update fixes.
advisories_section() {
  local notify=$1 out='' file=${AUR_FIXTURE:+$AUR_FIXTURE/arch-audit.txt} lines=()
  if [[ -n $file ]]; then
    [[ -f $file ]] && out=$(<"$file")
  elif have arch-audit; then
    out=$(arch-audit -u 2>/dev/null) || true
  else
    $notify || { section "Security advisories"; note "arch-audit is not installed (optional): sudo pacman -S arch-audit"; }
    return 0
  fi
  section "Security advisories"
  if [[ -z $out ]]; then
    ok "No installed package has a known vulnerability with a fix available"
    return 0
  fi
  mapfile -t lines <<<"$out"
  warn "${#lines[@]} installed packages have a known vulnerability with a fix available"
  printf '      %s\n' "${lines[@]:0:10}"
  (( ${#lines[@]} <= 10 )) || printf '      ... and %d more (run: arch-audit -u)\n' $(( ${#lines[@]} - 10 ))
  attention+=("${#lines[@]} packages with known vulnerabilities (run: arch-audit -u)")
}

cmd_status() {
  local notify=false
  [[ ${1:-} == --notify ]] && notify=true
  local attention=() line days out rc=0 repo aur=0

  section "Updates"
  days=$(last_upgrade_days)
  # checkupdates exits 2 when there is nothing to update, 1 on errors
  out=$(checkupdates --nocolor 2>&1) || rc=$?
  case $rc in
    0) repo=$(wc -l <<<"$out") ;;
    2) repo=0 ;;
    *) repo='?'; warn "checkupdates failed: ${out##*$'\n'}" ;;
  esac
  have yay && { aur=$(yay -Qua 2>/dev/null | wc -l) || true; }
  if (( days < 0 )); then
    warn "No full upgrade found in pacman.log; $repo repo + $aur AUR updates pending"
  elif (( days > MAX_AGE_DAYS )); then
    warn "Last full upgrade ${days} days ago; $repo repo + $aur AUR updates pending"
    attention+=("Last upgrade ${days} days ago ($repo + $aur updates pending)")
  else
    ok "Last full upgrade ${days} days ago; $repo repo + $aur AUR updates pending"
  fi

  aur_section
  advisories_section "$notify"

  section "Config files"
  mapfile -t pacnew < <(pacnew_files)
  if (( ${#pacnew[@]} )); then
    warn "${#pacnew[@]} .pacnew/.pacsave files to merge (run: arch-maintenance update)"
    printf '      %s\n' "${pacnew[@]}"
    attention+=("${#pacnew[@]} .pacnew files to merge")
  else
    ok "No .pacnew/.pacsave files"
  fi

  section "System"
  if reboot_needed; then
    warn "Running kernel $(uname -r) was replaced; reboot to load the new one"
    attention+=("Reboot needed (kernel updated)")
  else
    ok "Running kernel $(uname -r) is current"
  fi
  mapfile -t failed < <(failed_units)
  if (( ${#failed[@]} )); then
    warn "${#failed[@]} failed units:"
    printf '      %s\n' "${failed[@]}"
    attention+=("${#failed[@]} failed systemd units")
  else
    ok "No failed units"
  fi
  mapfile -t full < <(full_filesystems)
  if (( ${#full[@]} )); then
    for line in "${full[@]}"; do warn "Filesystem $line full"; done
    attention+=("Disk nearly full: ${full[*]}")
  else
    ok "All filesystems below ${DISK_WARN_PCT}%"
  fi

  if ! $notify; then
    section "Caches"
    ok "pacman cache: $(dir_size /var/cache/pacman/pkg)"
    [[ -d $HOME/.cache/yay ]] && ok "AUR build cache: $(dir_size "$HOME/.cache/yay")"
    local journal
    journal=$(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+[KMGT]' | head -n1) || true
    ok "journal: ${journal:-n/a}"
    if makepkg_debug_enabled; then
      warn "makepkg builds *-debug packages for every AUR build; add !debug to OPTIONS in makepkg.conf to stop"
    fi
  fi

  if $notify && (( ${#attention[@]} )) && have notify-send; then
    notify-send -a arch-maintenance -i system-software-update \
      "Arch maintenance needed" "$(printf '• %s\n' "${attention[@]}")" ||
      echo "notify-send failed (is a notification daemon running?)" >&2
  fi
}

cmd_aur() {
  case ${1:-} in
    baseline) shift; aur_baseline_cmd "$@" ;;
    check) local attention=(); aur_section; (( AUR_DRIFT == 0 )) ;;
    *) usage >&2; exit 1 ;;
  esac
}

aur_baseline_cmd() {
  local yes=false lines=() sev pkg msg base new=0 gone=0
  [[ ${1:-} == --yes ]] && yes=true
  section "AUR baseline"
  aur_load refresh || die "AUR baseline: $AUR_ERR"
  if (( ! ${#AUR_BASES[@]} )); then ok "No AUR packages installed"; return; fi
  if aur_load_baseline; then
    mapfile -t lines < <(aur_drift)
    for msg in "${lines[@]}"; do
      IFS=$'\t' read -r sev pkg msg <<<"$msg"
      [[ $sev == info ]] || warn "$pkg: $msg"
    done
    for base in "${AUR_BASES[@]}"; do [[ -n ${BL_VER[$base]:-} ]] || new=$((new + 1)); done
    for base in "${!BL_VER[@]}"; do [[ -n ${INST_VER[$base]:-} ]] || gone=$((gone + 1)); done
    ok "$new new and $gone removed packages since the last baseline"
  else
    ok "No baseline yet: ${#AUR_BASES[@]} packages will be recorded"
    warn "The baseline assumes your installed AUR packages are trustworthy today. It detects change, not existing compromise."
  fi
  if $yes || confirm "Record the current AUR state as the baseline?" n; then
    aur_baseline_write
    ok "Wrote $BASELINE"
  fi
}

# Before an upgrade builds AUR packages as your user: stop on drift unless
# confirmed. Skipped silently without a baseline or when the AUR is unreachable.
aur_gate() {
  local lines=() line sev pkg msg flagged=0
  [[ $AUR_CHECK != 0 ]] || return 0
  aur_load refresh && aur_load_baseline || return 0
  (( ${#AUR_BASES[@]} )) || return 0
  mapfile -t lines < <(aur_drift)
  for line in "${lines[@]}"; do
    IFS=$'\t' read -r sev pkg msg <<<"$line"
    [[ $sev == info ]] && continue
    (( flagged++ )) || section "AUR drift"
    warn "$pkg: $msg"
  done
  (( flagged == 0 )) || confirm "Review the AUR changes above. Continue with the upgrade?" n
}

cmd_update() {
  section "Arch news since your last upgrade"
  if have yay; then
    local news
    news=$(yay -Pw 2>/dev/null) || true
    if [[ -n $news ]]; then
      printf '%s\n\n' "$news"
      confirm "Read the news above. Any manual steps done? Continue with the upgrade?" n || exit 0
    else
      ok "No new announcements"
    fi
  else
    warn "yay not found; check https://archlinux.org/news/ before upgrading"
    confirm "Continue with the upgrade?" n || exit 0
  fi

  aur_gate || exit 0

  section "System upgrade"
  if have yay; then
    yay -Syu || die "Upgrade did not complete; stopping here."
  else
    sudo pacman -Syu || die "Upgrade did not complete; stopping here."
  fi

  # The upgrade is accepted, so record the new versions and PKGBUILD hashes.
  if [[ $AUR_CHECK != 0 && -f $BASELINE ]]; then
    if aur_load refresh && aur_load_baseline; then
      aur_baseline_write && ok "AUR baseline refreshed"
    else
      warn "AUR baseline not refreshed: ${AUR_ERR:-unreadable baseline}"
    fi
  fi

  # Also picks up the Flatpak GL extension matching a freshly upgraded NVIDIA driver.
  if have flatpak; then
    section "Flatpak"
    flatpak update -y
    flatpak uninstall --unused -y
  fi

  section "Config files (.pacnew / .pacsave)"
  mapfile -t pacnew < <(pacnew_files)
  if (( ${#pacnew[@]} )); then
    printf '      %s\n' "${pacnew[@]}"
    if confirm "Merge them now with pacdiff?" y; then
      local env=()
      [[ -n ${DIFFPROG:-} ]] && env=("DIFFPROG=$DIFFPROG")
      sudo env "${env[@]}" pacdiff
    fi
  else
    ok "Nothing to merge"
  fi

  section "Reboot"
  if reboot_needed; then
    warn "Kernel was upgraded; reboot to finish"
  else
    ok "No reboot needed for the kernel (restart updated apps and services as needed)"
  fi
}

cmd_clean() {
  section "Orphaned packages"
  mapfile -t orphans < <(pacman -Qdtq 2>/dev/null || true)
  if (( ${#orphans[@]} )); then
    printf '      %s\n' "${orphans[@]}"
    warn "Check the list: build tools you use directly may appear here"
    if confirm "Remove these ${#orphans[@]} packages (pacman -Rns)?" n; then
      sudo pacman -Rns "${orphans[@]}"
    fi
  else
    ok "No orphans"
  fi
  if makepkg_debug_enabled; then
    warn "makepkg 'debug' is enabled, which is why *-debug packages keep appearing; add !debug to OPTIONS in makepkg.conf"
  fi

  section "pacman package cache"
  ok "Current size: $(dir_size /var/cache/pacman/pkg)"
  if confirm "Keep the newest $CACHE_KEEP versions of installed packages and drop uninstalled ones?" y; then
    sudo paccache -rk"$CACHE_KEEP"
    sudo paccache -ruk0
    ok "Now: $(dir_size /var/cache/pacman/pkg)"
  fi

  if have yay && [[ -d $HOME/.cache/yay ]]; then
    section "AUR build cache"
    ok "Current size: $(dir_size "$HOME/.cache/yay")"
    warn "yay also asks about the pacman cache first; answer n there to keep what paccache kept"
    if confirm "Clean it with yay -Sc?" y; then
      yay -Sc
      ok "Now: $(dir_size "$HOME/.cache/yay")"
    fi
  fi

  section "Journal"
  ok "$(journalctl --disk-usage 2>/dev/null)"
  ok "Size is capped by SystemMaxUse in /etc/systemd/journald.conf.d/"
}

# ---------------------------------------------------------------------------

[[ $EUID -ne 0 ]] || die "Run as your normal user; sudo is used where needed."

case ${1:-status} in
  status) shift || true; cmd_status "$@" ;;
  update) cmd_update ;;
  clean) cmd_clean ;;
  aur) shift; cmd_aur "$@" ;;
  help | -h | --help) usage ;;
  version | --version) echo "arch-maintenance $VERSION" ;;
  *) usage >&2; exit 1 ;;
esac
