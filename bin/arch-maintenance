#!/usr/bin/env bash
# arch-maintenance: the interactive half of Arch Linux upkeep.
#
# Run as your normal user; sudo is requested only for steps that need it.
# The unattended half (Flatpak updates, package cache trimming, mirror refresh,
# TRIM, pacman DB snapshots, daily status notification) runs from systemd
# timers and a pacman hook installed by install.sh.

set -euo pipefail

readonly VERSION=2.0.0

# Tunables (environment overrides)
MAX_AGE_DAYS=${ARCH_MAINT_MAX_AGE_DAYS:-14}   # nag when the last full upgrade is older than this
DISK_WARN_PCT=${ARCH_MAINT_DISK_WARN_PCT:-90} # warn when a filesystem is fuller than this
CACHE_KEEP=${ARCH_MAINT_CACHE_KEEP:-2}        # package versions `clean` keeps in the pacman cache

if [[ -t 1 ]]; then
  BOLD=$'\e[1m' RED=$'\e[31m' GREEN=$'\e[32m' YELLOW=$'\e[33m' BLUE=$'\e[34m' NC=$'\e[0m'
else
  BOLD='' RED='' GREEN='' YELLOW='' BLUE='' NC=''
fi

section() { printf '\n%s==> %s%s\n' "$BLUE$BOLD" "$1" "$NC"; }
ok() { printf '  %s✓%s %s\n' "$GREEN" "$NC" "$1"; }
warn() { printf '  %s!%s %s\n' "$YELLOW" "$NC" "$1"; }
die() { printf '%serror:%s %s\n' "$RED" "$NC" "$1" >&2; exit 1; }
have() { command -v "$1" &>/dev/null; }

# confirm "question" [y|n]  (second argument is the default answer)
confirm() {
  local default=${2:-n} prompt reply
  [[ $default == y ]] && prompt='[Y/n]' || prompt='[y/N]'
  read -rp "  $1 $prompt " reply || return 1
  reply=${reply:-$default}
  [[ ${reply,,} == y* ]]
}

usage() {
  cat <<EOF
Usage: arch-maintenance [command]

Commands:
  status [--notify]  Report system health (default). --notify sends a desktop
                     notification when something needs attention.
  update             Arch news, full upgrade (repo + AUR), Flatpak update,
                     .pacnew merge, reboot check.
  clean              Review orphans, trim pacman and AUR caches.
  help               Show this help.
  version            Show version.

Environment:
  ARCH_MAINT_MAX_AGE_DAYS   Days before a stale upgrade is flagged (default 14)
  ARCH_MAINT_DISK_WARN_PCT  Disk usage warning threshold (default 90)
  ARCH_MAINT_CACHE_KEEP     Cached versions kept by 'clean' (default 2)
  DIFFPROG                  Merge tool passed to pacdiff (default: vim -d)
EOF
}

# ---------------------------------------------------------------------------
# Checks
# ---------------------------------------------------------------------------

last_upgrade_days() {
  local ts
  ts=$(grep -a 'starting full system upgrade' /var/log/pacman.log 2>/dev/null | tail -n1 | sed -E 's/^\[([^]]+)\].*/\1/')
  [[ -n $ts ]] || { echo -1; return; }
  echo $(( ($(date +%s) - $(date -d "$ts" +%s)) / 86400 ))
}

# The running kernel's modules disappear once a newer kernel is installed.
# Containers have no kernels in /usr/lib/modules, so there is nothing to compare.
reboot_needed() {
  compgen -G '/usr/lib/modules/*/vmlinuz' >/dev/null && [[ ! -d /usr/lib/modules/$(uname -r) ]]
}

pacnew_files() { pacdiff -o 2>/dev/null || true; }

failed_units() {
  systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}'
  systemctl --user --failed --no-legend --plain 2>/dev/null | awk '{print $1 " (user)"}'
}

# Real filesystems above the warning threshold, as "NN% /mount".
full_filesystems() {
  df --output=pcent,target -x tmpfs -x devtmpfs -x efivarfs -x overlay -x squashfs 2>/dev/null |
    awk -v max="$DISK_WARN_PCT" 'NR > 1 { p = $1; sub(/%/, "", p); if (p + 0 > max) print $1 " " $2 }'
}

# makepkg's `debug` option builds a *-debug package for every AUR build.
makepkg_debug_enabled() {
  local conf="${XDG_CONFIG_HOME:-$HOME/.config}/pacman/makepkg.conf"
  # grep exits 2 for the optional files that don't exist; don't let pipefail see it
  { grep -hsE '^[[:space:]]*OPTIONS=' /etc/makepkg.conf /etc/makepkg.conf.d/*.conf "$conf" "$HOME/.makepkg.conf" || true; } |
    tail -n1 | grep -qE '[( ]debug[ )]'
}

dir_size() { du -sh "$1" 2>/dev/null | cut -f1; }

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_status() {
  local notify=false
  [[ ${1:-} == --notify ]] && notify=true
  local attention=() line days out rc=0 repo aur=0

  section "Updates"
  days=$(last_upgrade_days)
  # checkupdates exits 2 when there is nothing to update, 1 on errors
  out=$(checkupdates --nocolor 2>&1) || rc=$?
  case $rc in
    0) repo=$(wc -l <<<"$out") ;;
    2) repo=0 ;;
    *) repo='?'; warn "checkupdates failed: ${out##*$'\n'}" ;;
  esac
  have yay && { aur=$(yay -Qua 2>/dev/null | wc -l) || true; }
  if (( days < 0 )); then
    warn "No full upgrade found in pacman.log; $repo repo + $aur AUR updates pending"
  elif (( days > MAX_AGE_DAYS )); then
    warn "Last full upgrade ${days} days ago; $repo repo + $aur AUR updates pending"
    attention+=("Last upgrade ${days} days ago ($repo + $aur updates pending)")
  else
    ok "Last full upgrade ${days} days ago; $repo repo + $aur AUR updates pending"
  fi

  section "Config files"
  mapfile -t pacnew < <(pacnew_files)
  if (( ${#pacnew[@]} )); then
    warn "${#pacnew[@]} .pacnew/.pacsave files to merge (run: arch-maintenance update)"
    printf '      %s\n' "${pacnew[@]}"
    attention+=("${#pacnew[@]} .pacnew files to merge")
  else
    ok "No .pacnew/.pacsave files"
  fi

  section "System"
  if reboot_needed; then
    warn "Running kernel $(uname -r) was replaced; reboot to load the new one"
    attention+=("Reboot needed (kernel updated)")
  else
    ok "Running kernel $(uname -r) is current"
  fi
  mapfile -t failed < <(failed_units)
  if (( ${#failed[@]} )); then
    warn "${#failed[@]} failed units:"
    printf '      %s\n' "${failed[@]}"
    attention+=("${#failed[@]} failed systemd units")
  else
    ok "No failed units"
  fi
  mapfile -t full < <(full_filesystems)
  if (( ${#full[@]} )); then
    for line in "${full[@]}"; do warn "Filesystem $line full"; done
    attention+=("Disk nearly full: ${full[*]}")
  else
    ok "All filesystems below ${DISK_WARN_PCT}%"
  fi

  if ! $notify; then
    section "Caches"
    ok "pacman cache: $(dir_size /var/cache/pacman/pkg)"
    [[ -d $HOME/.cache/yay ]] && ok "AUR build cache: $(dir_size "$HOME/.cache/yay")"
    local journal
    journal=$(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+[KMGT]' | head -n1) || true
    ok "journal: ${journal:-n/a}"
    if makepkg_debug_enabled; then
      warn "makepkg builds *-debug packages for every AUR build; add !debug to OPTIONS in makepkg.conf to stop"
    fi
  fi

  if $notify && (( ${#attention[@]} )) && have notify-send; then
    notify-send -a arch-maintenance -i system-software-update \
      "Arch maintenance needed" "$(printf '• %s\n' "${attention[@]}")" ||
      echo "notify-send failed (is a notification daemon running?)" >&2
  fi
}

cmd_update() {
  section "Arch news since your last upgrade"
  if have yay; then
    local news
    news=$(yay -Pw 2>/dev/null) || true
    if [[ -n $news ]]; then
      printf '%s\n\n' "$news"
      confirm "Read the news above. Any manual steps done? Continue with the upgrade?" n || exit 0
    else
      ok "No new announcements"
    fi
  else
    warn "yay not found; check https://archlinux.org/news/ before upgrading"
    confirm "Continue with the upgrade?" n || exit 0
  fi

  section "System upgrade"
  if have yay; then
    yay -Syu || die "Upgrade did not complete; stopping here."
  else
    sudo pacman -Syu || die "Upgrade did not complete; stopping here."
  fi

  # Also picks up the Flatpak GL extension matching a freshly upgraded NVIDIA driver.
  if have flatpak; then
    section "Flatpak"
    flatpak update -y
    flatpak uninstall --unused -y
  fi

  section "Config files (.pacnew / .pacsave)"
  mapfile -t pacnew < <(pacnew_files)
  if (( ${#pacnew[@]} )); then
    printf '      %s\n' "${pacnew[@]}"
    if confirm "Merge them now with pacdiff?" y; then
      local env=()
      [[ -n ${DIFFPROG:-} ]] && env=("DIFFPROG=$DIFFPROG")
      sudo env "${env[@]}" pacdiff
    fi
  else
    ok "Nothing to merge"
  fi

  section "Reboot"
  if reboot_needed; then
    warn "Kernel was upgraded; reboot to finish"
  else
    ok "No reboot needed for the kernel (restart updated apps and services as needed)"
  fi
}

cmd_clean() {
  section "Orphaned packages"
  mapfile -t orphans < <(pacman -Qdtq 2>/dev/null || true)
  if (( ${#orphans[@]} )); then
    printf '      %s\n' "${orphans[@]}"
    warn "Check the list: build tools you use directly may appear here"
    if confirm "Remove these ${#orphans[@]} packages (pacman -Rns)?" n; then
      sudo pacman -Rns "${orphans[@]}"
    fi
  else
    ok "No orphans"
  fi
  if makepkg_debug_enabled; then
    warn "makepkg 'debug' is enabled, which is why *-debug packages keep appearing; add !debug to OPTIONS in makepkg.conf"
  fi

  section "pacman package cache"
  ok "Current size: $(dir_size /var/cache/pacman/pkg)"
  if confirm "Keep the newest $CACHE_KEEP versions of installed packages and drop uninstalled ones?" y; then
    sudo paccache -rk"$CACHE_KEEP"
    sudo paccache -ruk0
    ok "Now: $(dir_size /var/cache/pacman/pkg)"
  fi

  if have yay && [[ -d $HOME/.cache/yay ]]; then
    section "AUR build cache"
    ok "Current size: $(dir_size "$HOME/.cache/yay")"
    warn "yay also asks about the pacman cache first; answer n there to keep what paccache kept"
    if confirm "Clean it with yay -Sc?" y; then
      yay -Sc
      ok "Now: $(dir_size "$HOME/.cache/yay")"
    fi
  fi

  section "Journal"
  ok "$(journalctl --disk-usage 2>/dev/null)"
  ok "Size is capped by SystemMaxUse in /etc/systemd/journald.conf.d/"
}

# ---------------------------------------------------------------------------

[[ $EUID -ne 0 ]] || die "Run as your normal user; sudo is used where needed."

case ${1:-status} in
  status) shift || true; cmd_status "$@" ;;
  update) cmd_update ;;
  clean) cmd_clean ;;
  help | -h | --help) usage ;;
  version | --version) echo "arch-maintenance $VERSION" ;;
  *) usage >&2; exit 1 ;;
esac
