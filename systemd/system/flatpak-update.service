[Unit]
Description=Update system Flatpak apps and remove unused runtimes
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak update --noninteractive -y
ExecStart=/usr/bin/flatpak uninstall --unused --noninteractive -y
Nice=19
IOSchedulingClass=idle
